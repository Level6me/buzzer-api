[Unit]
Description=Raspberry Pi Buzzer API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/jiang/buzzer-api
ExecStart=/home/jiang/buzzer-api/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001 --timeout-graceful-shutdown 2
Restart=always
RestartSec=2
TimeoutStopSec=4

[Install]
WantedBy=multi-user.target
